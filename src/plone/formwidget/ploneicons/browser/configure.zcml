<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="plone.formwidget.ploneicons"
    >

  <!-- Set overrides folder for Just-a-Bunch-Of-Templates product -->
  <include
      package="z3c.jbot"
      file="meta.zcml"
      />
  <browser:jbot
      directory="overrides"
      layer="plone.formwidget.ploneicons.interfaces.IBrowserLayer"
      />

  <browser:page
      name="icon-selector-modal"
      for="*"
      class=".modal.IconSelectorModal"
      template="modal.pt"
      permission="zope2.View"
      layer="plone.formwidget.ploneicons.interfaces.IBrowserLayer"
      />

  <!-- z3c.form widget templates -->
  <browser:page
      name="plone.formwidget.ploneicons.widget"
      for="plone.formwidget.ploneicons.interfaces.IPloneIconsWidget"
      template="widget.pt"
      permission="zope2.View"
      layer="plone.formwidget.ploneicons.interfaces.IBrowserLayer"
      />

  <!-- Publish static files -->
  <plone:static
      directory="static"
      name="plone.formwidget.ploneicons"
      type="plone"
      />

</configure>
