<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:z3c="http://namespaces.zope.org/z3c"
    i18n_domain="plone.formwidget.ploneicons"
    >

  <i18n:registerTranslations directory="locales" />

  <include file="dependencies.zcml" />
  <include file="profiles.zcml" />

  <include package=".vocabularies" />
  <include package=".browser" />
  <include
      package="z3c.form"
      file="meta.zcml"
      />
  <include package="z3c.form" />

  <class class=".widget.PloneIconsWidget">
    <require
        permission="zope2.View"
        interface=".interfaces.IPloneIconsWidget"
        />
  </class>

  <adapter factory=".widget.PloneIconsFieldWidget" />

  <interface
      interface=".interfaces.IPloneIconsWidget"
      type="z3c.form.interfaces.IWidget"
      />

  <z3c:widgetTemplate
      widget=".interfaces.IPloneIconsWidget"
      template="browser/widget.pt"
      layer=".interfaces.IBrowserLayer"
      mode="display"
      />

  <z3c:widgetTemplate
      widget=".interfaces.IPloneIconsWidget"
      template="browser/widget.pt"
      layer=".interfaces.IBrowserLayer"
      mode="input"
      />

  <!-- -*- extra stuff goes here -*- -->

</configure>
